/* =========================================================
   VENDA FÁCIL - LIGHT MODE
========================================================= */

QMainWindow {
    background-color: #f5f7fb;
}

QWidget {
    font-family: "Bahnschrift";
    font-size: 13px;
    font-weight: 400;
    color: #111827;
}

QStackedWidget {
    background-color: #f5f7fb;
}


/* =========================
   SIDEBAR
========================= */

#sidebar {
    background-color: #0b1220;
    border-right: 1px solid #182235;
}

#logo {
    color: #ffffff;

    font-family: "Bahnschrift";
    font-size: 24px;
    font-weight: 600;
}

#logoDescricao {
    color: #64748b;

    font-size: 10px;
    font-weight: 500;
}

#menuButton {
    background-color: transparent;

    color: #94a3b8;

    border: none;
    border-radius: 9px;

    padding: 12px 14px;

    text-align: left;

    font-size: 13px;
    font-weight: 500;
}

#menuButton:hover {
    background-color: #151f31;
    color: #ffffff;
}

#menuButton:checked {
    background-color: #172554;

    color: #60a5fa;

    border-left: 3px solid #3b82f6;

    padding-left: 11px;
}

#menuButton:pressed {
    background-color: #1e293b;
}

#versao {
    color: #475569;

    font-size: 10px;
    font-weight: 400;
}


/* =========================
   CABEÇALHOS
========================= */

#pageTitulo {
    color: #0f172a;

    font-family: "Bahnschrift";
    font-size: 29px;
    font-weight: 600;
}

#pageSubtitulo {
    color: #64748b;

    font-size: 13px;
    font-weight: 400;
}

#dialogTitulo {
    color: #0f172a;

    font-family: "Bahnschrift";
    font-size: 21px;
    font-weight: 600;
}


/* =========================
   DATA DO DASHBOARD
========================= */

#dashboardDate {
    color: #64748b;

    background-color: #ffffff;

    border: 1px solid #e5eaf1;
    border-radius: 9px;

    padding: 8px 12px;

    font-size: 12px;
    font-weight: 400;
}


/* =========================
   CARDS
========================= */

#card,
#metricCard,
#dashboardPanel,
#reportMetricCard,
#reportPanel {
    background-color: #ffffff;

    border: 1px solid #e2e8f0;
    border-radius: 14px;
}

#card {
    padding: 18px;

    min-height: 115px;
}

#cardTitulo,
#metricLabel,
#reportMetricLabel {
    color: #64748b;

    font-size: 10px;
    font-weight: 500;
}

#cardValor,
#metricValue,
#reportMetricValue {
    color: #0f172a;

    font-family: "Bahnschrift";
    font-size: 26px;
    font-weight: 600;
}

#metricDescription,
#reportMetricDescription {
    color: #94a3b8;

    font-size: 11px;
    font-weight: 400;
}


/* =========================
   PAINÉIS
========================= */

#dashboardPanel {
    min-height: 200px;
}

#reportPanel {
    min-height: 220px;
}

#panelTitle,
#reportPanelTitle {
    color: #0f172a;

    font-size: 15px;
    font-weight: 600;
}

#panelDescription,
#reportPanelDescription {
    color: #94a3b8;

    font-size: 11px;
    font-weight: 400;
}


/* =========================
   INPUTS
========================= */

QLineEdit,
QComboBox,
QSpinBox {
    background-color: #ffffff;

    color: #0f172a;

    border: 1px solid #d9e0ea;
    border-radius: 9px;

    padding: 10px 12px;

    font-size: 13px;
    font-weight: 400;

    selection-background-color: #2563eb;
}

QLineEdit:hover,
QComboBox:hover,
QSpinBox:hover {
    border-color: #b9c4d3;
}

QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus {
    border: 1px solid #3b82f6;
}


/* =========================
   COMBOBOX
========================= */

QComboBox::drop-down {
    border: none;

    width: 28px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;

    color: #0f172a;

    border: 1px solid #e2e8f0;

    selection-background-color: #eff6ff;
    selection-color: #1d4ed8;

    padding: 5px;

    outline: none;

    font-size: 13px;
}


/* =========================
   TABELAS
========================= */

QTableWidget {
    background-color: #ffffff;

    alternate-background-color: #fafbfc;

    color: #111827;

    border: 1px solid #e5eaf1;
    border-radius: 12px;

    gridline-color: transparent;

    selection-background-color: #eff6ff;
    selection-color: #0f172a;

    outline: none;

    font-size: 13px;
    font-weight: 400;
}

QTableWidget::item {
    padding: 9px;

    border-bottom: 1px solid #f1f5f9;
}

QTableWidget::item:hover {
    background-color: #f8fafc;
}

QTableWidget::item:selected {
    background-color: #eff6ff;

    color: #1e40af;
}

QHeaderView {
    background-color: #ffffff;
}

QHeaderView::section {
    background-color: #f8fafc;

    color: #64748b;

    border: none;
    border-bottom: 1px solid #e5e7eb;

    padding: 11px;

    font-size: 11px;
    font-weight: 600;
}


/* =========================
   BOTÃO PRINCIPAL
========================= */

#primaryButton {
    background-color: #2563eb;

    color: #ffffff;

    border: none;
    border-radius: 9px;

    padding: 11px 18px;

    font-size: 13px;
    font-weight: 600;
}

#primaryButton:hover {
    background-color: #1d4ed8;
}

#primaryButton:pressed {
    background-color: #1e40af;
}


/* =========================
   BOTÃO SECUNDÁRIO
========================= */

#secondaryButton {
    background-color: #ffffff;

    color: #334155;

    border: 1px solid #dbe2ea;
    border-radius: 9px;

    padding: 10px 16px;

    font-size: 12px;
    font-weight: 500;
}

#secondaryButton:hover {
    background-color: #f8fafc;

    border-color: #cbd5e1;
}


/* =========================
   EDITAR
========================= */

#editButton {
    background-color: #eff6ff;

    color: #2563eb;

    border: 1px solid #dbeafe;
    border-radius: 7px;

    padding: 7px 12px;

    font-size: 12px;
    font-weight: 500;
}

#editButton:hover {
    background-color: #dbeafe;

    color: #1d4ed8;
}


/* =========================
   EXCLUIR
========================= */

#deleteButton {
    background-color: #fff1f2;

    color: #e11d48;

    border: 1px solid #ffe4e6;
    border-radius: 7px;

    padding: 7px 12px;

    font-size: 12px;
    font-weight: 500;
}

#deleteButton:hover {
    background-color: #ffe4e6;

    color: #be123c;
}


/* =========================
   DETALHES
========================= */

#detailsButton {
    background-color: #f1f5f9;

    color: #334155;

    border: none;
    border-radius: 7px;

    padding: 8px 12px;

    font-size: 12px;
    font-weight: 500;
}

#detailsButton:hover {
    background-color: #e2e8f0;
}


/* =========================
   NOVA VENDA
========================= */

#saleFooter {
    background-color: #ffffff;

    border: 1px solid #e5eaf1;
    border-radius: 13px;
}

#fieldLabel,
#totalTitulo {
    color: #64748b;

    font-size: 10px;
    font-weight: 500;
}

#totalValor {
    color: #0f172a;

    font-family: "Bahnschrift";
    font-size: 28px;
    font-weight: 600;
}

#finishButton {
    background-color: #16a34a;

    color: #ffffff;

    border: none;
    border-radius: 9px;

    padding: 13px 24px;

    font-size: 13px;
    font-weight: 600;
}

#finishButton:hover {
    background-color: #15803d;
}

#finishButton:pressed {
    background-color: #166534;
}


/* =========================
   HISTÓRICO
========================= */

#historySummary {
    color: #64748b;

    font-size: 12px;
    font-weight: 500;
}


/* =========================
   PAGAMENTOS
========================= */

#paymentRow {
    background-color: #f8fafc;

    border: 1px solid #f1f5f9;
    border-radius: 8px;
}

#paymentName {
    color: #475569;

    font-size: 12px;
    font-weight: 400;
}

#paymentValue {
    color: #0f172a;

    font-size: 13px;
    font-weight: 600;
}


/* =========================
   DESTAQUES
========================= */

#highlightValue {
    color: #0f172a;

    font-family: "Bahnschrift";
    font-size: 25px;
    font-weight: 600;
}

#highlightDescription {
    color: #64748b;

    font-size: 12px;
    font-weight: 400;
}

#emptyText {
    color: #94a3b8;

    font-size: 12px;
    font-weight: 400;

    padding: 20px;
}


/* =========================
   SCROLLBAR
========================= */

QScrollBar:vertical {
    background-color: transparent;

    width: 10px;

    margin: 3px;
}

QScrollBar::handle:vertical {
    background-color: #cbd5e1;

    border-radius: 5px;

    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #94a3b8;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: transparent;

    height: 10px;

    margin: 3px;
}

QScrollBar::handle:horizontal {
    background-color: #cbd5e1;

    border-radius: 5px;

    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #94a3b8;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}


/* =========================
   DIALOG
========================= */

QDialog {
    background-color: #f8fafc;
}


/* =========================
   MESSAGE BOX
========================= */

QMessageBox {
    background-color: #ffffff;
}

QMessageBox QLabel {
    color: #0f172a;

    font-size: 13px;
    font-weight: 400;
}

QMessageBox QPushButton {
    background-color: #2563eb;

    color: #ffffff;

    border: none;
    border-radius: 7px;

    padding: 7px 16px;

    min-width: 75px;

    font-size: 12px;
    font-weight: 500;
}

QMessageBox QPushButton:hover {
    background-color: #1d4ed8;
}


/* =========================
   BOTÃO DE TEMA
========================= */

#themeButton {
    background-color: transparent;

    color: #94a3b8;

    border: 1px solid #334155;
    border-radius: 8px;

    padding: 10px 12px;

    text-align: left;

    font-size: 12px;
    font-weight: 500;
}

#themeButton:hover {
    background-color: #172033;

    color: #ffffff;

    border-color: #475569;
}
/* =========================================================
   LOGIN
========================================================= */

#loginLogo {
    font-family: "Bahnschrift";
    font-size: 27px;
    font-weight: 600;
}

#loginSubtitle {
    color: #64748b;

    font-size: 10px;
    font-weight: 500;
}

#loginTitle {
    font-family: "Bahnschrift";

    font-size: 20px;
    font-weight: 600;
}

#loginDescription {
    color: #64748b;

    font-size: 12px;
    font-weight: 400;
}

#loginFieldLabel {
    color: #64748b;

    font-size: 10px;
    font-weight: 500;
}

#loginButton {
    background-color: #2563eb;

    color: white;

    border: none;
    border-radius: 9px;

    padding: 12px;

    font-size: 13px;
    font-weight: 600;
}

#loginButton:hover {
    background-color: #1d4ed8;
}

#loginButton:pressed {
    background-color: #1e40af;
}


/* USUÁRIO LOGADO */

#userLabel {
    color: #475569;

    font-size: 9px;
    font-weight: 500;
}

#userName {
    color: #cbd5e1;

    font-size: 12px;
    font-weight: 500;
}